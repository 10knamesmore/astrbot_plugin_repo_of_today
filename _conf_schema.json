{
  "enabled": {
    "description": "是否启用每日定时推送",
    "type": "bool",
    "default": false
  },
  "append_to_message_chain": {
    "description": "推送后是否将消息追加到当前会话的对话历史 (供 LLM 上下文使用)",
    "type": "bool",
    "default": false,
    "hint": "开启后，每次推送会以 assistant 角色写入对应会话当前对话的 history"
  },
  "push_time": {
    "description": "每日推送时间 (HH:MM, 24h)",
    "type": "string",
    "default": "09:00",
    "hint": "示例: 09:00"
  },
  "push_count": {
    "description": "每种语言推送的仓库数量",
    "type": "int",
    "default": 5,
    "hint": "建议范围 1-10"
  },
  "languages": {
    "description": "关注的语言；留空则推送综合榜",
    "type": "list",
    "default": [],
    "hint": "下拉多选。留空 → 推送综合榜的 push_count 条（1 条消息）；填入 1 种 → 该语言的 push_count 条（1 条消息）；填入 N 种 → 每种语言各 push_count 条（N 条消息）；只要填入任意语言就不再推送综合榜",
